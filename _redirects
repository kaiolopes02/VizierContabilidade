# Force HTTPS on custom domain (redundância com HSTS)
http://viziercontabilidade.com.br/* https://viziercontabilidade.com.br/:splat 301
http://www.viziercontabilidade.com.br/* https://www.viziercontabilidade.com.br/:splat 301

# WWW to non-WWW redirect
https://www.viziercontabilidade.com.br/* https://viziercontabilidade.com.br/:splat 301

# Block common attack paths (return 404)
/.env/* /404.html 404
/.git/* /404.html 404
/.svn/* /404.html 404
/.hg/* /404.html 404
/config.php /404.html 404
/config.json /404.html 404
/wp-admin/* /404.html 404
/wp-login.php /404.html 404
/xmlrpc.php /404.html 404
/admin/* /404.html 404
/phpmyadmin/* /404.html 404
/.htaccess /404.html 404
/.htpasswd /404.html 404
/robots.txt /404.html 404
/server-status /404.html 404
